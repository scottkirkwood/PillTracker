<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:rotation="35"
        android:pivotX="54"
        android:pivotY="54">

        <!-- Pill Drop Shadow -->
        <path
            android:pathData="M38,44 L70,44 A14,14 0 0,1 84,58 A14,14 0 0,1 70,72 L38,72 A14,14 0 0,1 24,58 A14,14 0 0,1 38,44 Z"
            android:fillColor="#4D000000" />

        <!-- Left Half of Capsule (ForUsers Blue #6699FF) -->
        <path
            android:pathData="M54,40 L38,40 A14,14 0 0,0 24,54 A14,14 0 0,0 38,68 L54,68 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="24"
                    android:startY="40"
                    android:endX="54"
                    android:endY="68"
                    android:type="linear">
                    <item android:color="#FF76A4FF" android:offset="0.0" />
                    <item android:color="#FF6699FF" android:offset="0.5" />
                    <item android:color="#FF4D7CE5" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Half of Capsule (Crisp White #FFFFFF) -->
        <path
            android:pathData="M54,40 L70,40 A14,14 0 0,1 84,54 A14,14 0 0,1 70,68 L54,68 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="40"
                    android:endX="84"
                    android:endY="68"
                    android:type="linear">
                    <item android:color="#FFFFFFFF" android:offset="0.0" />
                    <item android:color="#FFF1F5F9" android:offset="0.7" />
                    <item android:color="#FFE2E8F0" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Seam line between capsule halves -->
        <path
            android:pathData="M54,40 L54,68"
            android:strokeWidth="1.2"
            android:strokeColor="#33000000" />

        <!-- Upper Gloss Reflection -->
        <path
            android:pathData="M34,44 L74,44 A2,2 0 0,1 76,46 A2,2 0 0,1 74,48 L34,48 A2,2 0 0,1 32,46 A2,2 0 0,1 34,44 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="32"
                    android:startY="46"
                    android:endX="76"
                    android:endY="46"
                    android:type="linear">
                    <item android:color="#4DFFFFFF" android:offset="0.0" />
                    <item android:color="#99FFFFFF" android:offset="0.5" />
                    <item android:color="#66FFFFFF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

    </group>
</vector>